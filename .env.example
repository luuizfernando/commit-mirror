# One .env per stack on the VPS: /projects/commit-mirror (production) and
# /projects/commit-mirror-homolog (homolog). Homolog never shares a bot, database or log repository with production.

# --- Image (compose) ---
# Production uses release versions (0.1.3); homolog uses release candidates (0.1.3-rc.42). Updated by deploy.sh.
IMAGE_TAG=0.1.1
# Host port the app is published on (127.0.0.1 only): 8080 in production, 8090 in homolog
APP_HOST_PORT=8080
# Keeps containers and volumes of the two stacks apart: commit-mirror / commit-mirror-homolog
COMPOSE_PROJECT_NAME=commit-mirror

# --- Database ---
POSTGRES_DB=commit_mirror
POSTGRES_USER=commit_mirror
POSTGRES_PASSWORD=
# JDBC URL of the db container, e.g. jdbc:postgresql://db:5432/commit_mirror
DB_URL=

# --- Telegram (required: the app refuses to start without the first three) ---
# Each environment needs its own bot: Telegram allows a single webhook per bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_BASE_URL=https://api.telegram.org

# --- GitHub (fine-grained PAT, this repository only, Contents: read/write) ---
# Homolog must point to a separate log repository, so test commits never reach the production log.
APP_GITHUB_PAT=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_API_URL=https://api.github.com
LOGS_DIRECTORY=commit-logs
# Must be an e-mail linked to your GitHub account, otherwise the commits do not count on the graph
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# --- Misc ---
APP_TIME_ZONE=America/Sao_Paulo

# --- Recovery of unfinished commits (optional, these are the defaults) ---
RECOVERY_ENABLED=true
RECOVERY_INTERVAL=60s
RECOVERY_MIN_AGE=5m
RECOVERY_MAX_ATTEMPTS=3
